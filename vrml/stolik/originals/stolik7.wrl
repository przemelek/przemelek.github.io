#zwierciad³o dolne

DEF zwierciadlo Transform {

#rotation 0 0 1 -0.4 
rotation 0 0 1 -1.1

translation -2.1 -0.5 -3.0

children [
Transform {

#translation 3.5 2.5 -3
#translation 0 2.0 -3



       children [
          Shape { 
                appearance Appearance {
				 material DEF zwierciadlo Material {
					     emissiveColor .5 .5 .5
					     transparency 0.5

					 }
			   }
	         geometry Box {
			size 1 0.2 1
		}
            }
    ]
}
]
}

