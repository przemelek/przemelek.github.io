DEF Kamera Viewpoint {
	fieldOfView 1.3
	jump        FALSE
	orientation 0 1 0 3.14
	position    0 5 -20
	description "Start1"
}

Viewpoint {
	fieldOfView 1.3
	jump        FALSE
#	orientation 0 1 0 3.14
	orientation 1 0 0 -1.57
	position    0 25 0
	description "Start2"
}

Viewpoint {
	fieldOfView 1.3
	jump        FALSE
	orientation 0 1 0 -1.57
	position    -20 5 0
	description "Start3"
}

Viewpoint {
	fieldOfView 1.3
	jump        FALSE
	orientation 0 1 0 0
	position    0 15 20
	description "Start4"
}

Viewpoint {
	fieldOfView 1.3
	jump        FALSE
	orientation 1 0 0 -0.5
	position    0 20 20
	description "Start5"
}

Viewpoint {
	fieldOfView 1.3
	jump        FALSE
	orientation 0 1 0 1.57
	position    20 5 0

	description "Start6"
}

PointLight {
  intensity 0.5
  color 1 1 1
  location 0 5 -20
}

PointLight {
  intensity 0.5
  color 1 1 1
  location 0 5 20
}

SpotLight {
#  exposedField SFFloat ambientIntensity  0 
#  exposedField SFVec3f attenuation       1 0 0
#  exposedField SFFloat beamWidth         1.570796
#  exposedField SFColor color             1 1 1 
#  exposedField SFFloat cutOffAngle       0.785398
#  exposedField SFVec3f direction         0 0 -1
#  exposedField SFFloat intensity         1  
#  exposedField SFVec3f location          0 0 0  
#  exposedField SFBool  on                TRUE
#  exposedField SFFloat radius            100 
   color 0.1 0 0
   location -2 10 -2.5
   direction 1 0 0
}



#Pod³o¿e
Transform {
    translation 0 0 0
       children [
          Shape { 
                appearance Appearance {
				material Material {
					     emissiveColor 0 0 0.1
#					     transparency 1.0
					 }
			   }
	         geometry Box {
			size 20 0.1 20
		}
            }
    ]
}

