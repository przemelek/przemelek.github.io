NavigationInfo {
  headlight        FALSE
  type		   "EXAMINE"
}

DEF pozycja PositionInterpolator {
#  eventIn      SFFloat set_fraction
#  exposedField MFFloat key           []
   key 	         [0 0.5 1]
   keyValue      [0 6 0.5, 0 5 0.5 0, 6 0.5]
#  eventOut     SFVec3f value_changed
}

DEF obrocik OrientationInterpolator {
#  eventIn      SFFloat    set_fraction
#  exposedField MFFloat    key           []
#  exposedField MFRotation keyValue         []
#  eventOut     SFRotation value_changed
   key 		[0 0.5 1]
   keyValue 	[0 0 1 0, 0 0 1 1.57, 0 0 1 0]
}

DEF kolor ColorInterpolator {
#  eventIn      SFFloat set_fraction
#  exposedField MFFloat key           []
#  exposedField MFColor keyValue      []
#  eventOut     SFColor value_changed
   key          [0 0.5 1]
   keyValue     [1 0 0, 0.5 0 0, 1 0 0]
}

DEF rozmiar PositionInterpolator {
#  eventIn      SFFloat set_fraction
#  exposedField MFFloat key           []
   key 	         [0 0.5 1]
   keyValue      [1 0.9 1, 1 1.2 1, 1 0.9 1]
#  eventOut     SFVec3f value_changed
}

DEF czas TimeSensor {
	loop TRUE
}

ROUTE czas.fraction_changed TO pozycja.set_fraction
ROUTE pozycja.value TO support.set_translation

ROUTE czas.fraction_changed TO obrocik.set_fraction
#ROUTE obrocik.value TO wiazka.set_rotation

ROUTE czas.fraction_changed TO kolor.set_fraction
ROUTE kolor.value TO kolor_wiazki.set_emissiveColor

ROUTE czas.fraction_changed TO rozmiar.set_fraction
ROUTE rozmiar.value TO wiazka2.set_scale
