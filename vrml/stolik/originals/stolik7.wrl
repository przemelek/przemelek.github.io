#laser

DEF laser Transform {

#rotation 0 0 1 -0.4 
#rotation 0 0 1 1.05
rotation 0 0 1 2.62

translation -2 12.125 -2.5

children [

Transform {
#   translation 0 12 -2.5
   rotation 0 0 1 1.57
   children [
		DEF Glowa Shape {
		appearance Appearance {
			material Material {
 					     emissiveColor 0 0.3 0.3
					  }
				}
	geometry Cylinder {
		          height 3
			  radius .5
			}

		}
	]
}


]
}


