DEF pojemnik Transform {
translation 0 0.5 0
children [

Transform {
translation 2.0 0 -2.1
       children [
          Shape { 
                appearance Appearance {
				material Material {
 					     emissiveColor 0 0 0.5
					     transparency 0.5
					 }
			   }
	         geometry Box {
			size 1 0.2 4
		}
            }
    ]
}



Transform {
   translation 2 1 -4
  children [
		Shape {
		appearance Appearance {
			material Material {
 					     emissiveColor 0 0 0.5
					     transparency 0.5
					  }
				}
	         geometry Box {
			size 1 2 0.2
		}

		}
	]
}

Transform {
   translation 2.5 1 -2
  children [
		DEF scianka Shape {
		appearance Appearance {
			material Material {
 					     emissiveColor 0 0 0.5
					     transparency 0.5
					  }
				}
	         geometry Box {
			size 0.2 2 4
		}

		}
	]
}

Transform {
   translation 1.5 1 -2
   children [ USE scianka ]
}

Transform {
translation 2 1 -1.95
       children [
          Shape { 
                appearance Appearance {
				material Material {
					     emissiveColor 1 1 1
					     transparency 0.8

					 }
			   }
	         geometry Box {
			size 0.8 1.8 3.8
		}
            }
    ]
}

]
}

#Drugi pojemnik, ten do "wyrównania" wi¹zki

Transform {
translation -4 0 0
children [ USE pojemnik ]
}

