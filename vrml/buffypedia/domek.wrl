#Czyżby łonko? ;-)
DEF ObrotKuli Transform {
children [
Transform {
#       translation -500 500 -500   # Co kurde blisko, nie?
       translation 0 612 -612
       children [
#Słońce
DEF Swiatlo PointLight {
        location -5 -5 -5
        color    0.75 0.75 0.75
        }
Viewpoint {
	fieldOfView 0.7
	jump        FALSE
	orientation 0 0 0 0
	position    0 0 0
	description "W sloncu"
}


          Shape { 
                appearance Appearance {
		 material DEF Slonko Material {
					     emissiveColor 1.0 1.0 0
					 }
			   }
	         geometry Sphere { radius 25.0 }
            }
    ]
}
]
}


