						-6.05  5.9  2.0

						-5.95  2.8 -3.5
						-5.95  2.8  2.0
						-5.95  5.9  2.0

						-5.0  5.9  2.0
						-5.0  5.9 -2
						-5.0  3.6 -2


					      ]
				                         }
				coordIndex [
					   0,1,2,-1
					   3,4,5,-1
					   2,1,0,-1
