#29/07/2000
#Projekt jest już tak duży, że na moim komputerze, nie da się go praktycznie oglšdać
#jego oglšdanie odbywa się w okienku o rozmiarach 240x180


#Najbardziej wysunięta na prawo częć dachu
Group { 
	children [
		Shape {
                appearance Appearance {
				texture ImageTexture { url "wood.jpg" }
#				material Material {
#					     emissiveColor 1 0 0.5
#					 }
}
			geometry IndexedFaceSet {
					normalPerVertex FALSE
					coord Coordinate {
					point [
#						7.0  2.8 -3.0
#						7.0  7.0  6.0
#						5.0  7.0  6.0
#						5.0  2.8 -3.0

						6.5  2.8 -3.5
						6.5  7.0  4.0
						5.0  7.0  4.0
						5.0  2.8 -3.5

					      ]
				                         }
				coordIndex [
					   0,1,2,3,-1
					   3,2,1,0,-1
				           ] 
			                        }
		   }
	       ]
     }
